.shelf {
  padding: 24rpx 40rpx 48rpx;
}

.search {
  height: 68rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border-radius: 34rpx;
  background: #ece7dc;
}

.s-icon {
  color: var(--muted);
  font-size: 32rpx;
  margin-right: 12rpx;
}

.s-input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
}

.s-clear {
  color: var(--muted);
  font-size: 36rpx;
  padding-left: 20rpx;
}

/* 分组方式 */
.modes {
  white-space: nowrap;
  margin: 0 -40rpx 32rpx;
  padding: 0 40rpx;
  width: auto;
}

.mode {
  display: inline-block;
  margin-right: 16rpx;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  background: var(--chip);
  color: #5d594f;
  font-size: 26rpx;
}

.mode.on {
  background: var(--tea);
  color: #fff;
}

.sect + .sect {
  margin-top: 56rpx;
}

.sect-h {
  margin-bottom: 24rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid var(--line);
}

.sect-t {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 32rpx;
  font-weight: 600;
}

.sect-n {
  color: var(--muted);
  font-size: 24rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 44rpx 40rpx;
}

.cell {
  width: calc((100% - 80rpx) / 3);
  text-align: center;
}

.cap {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.4;
}

.sub {
  display: block;
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hint {
  margin-top: 48rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.cap.dim {
  color: #b3ad9f;
}

.none {
  padding: 120rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}
