.tip {
  margin-bottom: 16rpx;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.ph {
  position: relative;
  width: 202rpx;
  height: 202rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: var(--chip);
}

.ph image {
  width: 100%;
  height: 100%;
}

.ph .del {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 36rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-left-radius: 14rpx;
}

.ph .edit {
  position: absolute;
  top: 0;
  left: 0;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-bottom-right-radius: 14rpx;
}

.cover-tag {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(74, 107, 79, 0.85);
}

.cover-tag.set {
  background: rgba(0, 0, 0, 0.35);
}

.ph.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--line);
  box-sizing: border-box;
}

.ph.add .plus {
  font-size: 56rpx;
  color: var(--tea);
  line-height: 1.2;
}

.ph.add .muted {
  font-size: 22rpx;
}

.ph-text {
  color: #b5b0a3;
}

.add-chip {
  background: transparent;
  border: 2rpx dashed var(--line);
  color: var(--tea);
}
