.tname {
  font-size: 34rpx;
  font-weight: 600;
}

.cat {
  margin: 0 14rpx;
  font-size: 24rpx;
  color: var(--tea);
}

.steep {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.steep:last-child {
  border-bottom: none;
}

.sn {
  font-weight: 600;
}

.sub {
  margin-top: 8rpx;
  font-size: 26rpx;
}

.stag {
  color: var(--tea-d);
}

.slq {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-left: 16rpx;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.85), 0 0 0 2rpx #e4dccb;
}

.srev {
  margin-left: 10rpx;
}

.rate {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.star {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 56rpx;
  color: #d8d0bd;
}

.star.on {
  color: #d9a441;
}

.note {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: var(--chip);
  border-radius: 16rpx;
  font-size: 28rpx;
}

/* 评鉴建议 */
.remind {
  border: 2rpx solid #f0d9b0;
  background: #fdf6e9;
}

/* 第一步：无转写文字的空态说明 */
.voice-empty {
  border: 2rpx dashed #d9d2bf;
  background: #faf7f0;
}

.voice-empty .muted {
  margin-top: 8rpx;
  line-height: 1.6;
}

.remind-chips {
  margin-top: 16rpx;
}

.remind-chip {
  background: #f6e3cf;
  color: var(--warn);
}

/* AI 整理状态 */
.ai-status {
  margin-top: 12rpx;
  line-height: 1.6;
}

/* 步进：返回 AI 总结与原文 */
.back {
  padding: 8rpx 4rpx 24rpx;
  font-size: 28rpx;
  color: var(--tea);
}

/* 原文与录音（总评卡内展开） */
.voice-toggle {
  margin-top: 16rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--tea);
}

.voice-detail {
  margin-top: 8rpx;
}

.voice-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.voice-item:first-of-type {
  margin-top: 4rpx;
}

.voice-row {
  display: flex;
  align-items: flex-start;
}

.voice-audios {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.audio-btn {
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  background: var(--chip);
  font-size: 24rpx;
  color: var(--tea-d);
}

.audio-btn.on {
  background: var(--tea);
  color: #fff;
}

/* AI 整理稿（总评 + 专业评审） */
.ai-draft {
  border: 2rpx solid #dbe7dc;
  background: #f4f9f4;
}

.draft-block {
  margin-top: 16rpx;
}

.draft-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.draft-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #2b2a26;
  white-space: pre-wrap;
}

.voice-speaker {
  flex-shrink: 0;
  margin-right: 16rpx;
  color: var(--tea-d);
  font-weight: 600;
}

.voice-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
}

/* 语音评论编辑弹层 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: flex-end;
}

.pop {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: var(--paper);
}

.pop-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.voice-pop {
  z-index: 51;
}

.voice-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
}

.voice-textarea {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  background: var(--chip);
  border-radius: 16rpx;
  font-size: 28rpx;
}

.voice-actions {
  margin-top: 24rpx;
}

.voice-save {
  width: 200rpx;
}
