.home {
  padding: 16rpx 40rpx 48rpx;
}

.sync {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #f6e3cf;
  color: var(--warn);
  font-size: 26rpx;
}

/* 今日茶历 */
.almanac {
  display: flex;
  flex-direction: column;
}

.term {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 72rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  color: var(--tea-d);
}

.date {
  font-size: 24rpx;
  color: var(--muted);
}

.rule {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #5b574c;
}

/* 时辰 */
.clock {
  display: flex;
  margin: 36rpx 0 40rpx;
}

.hour {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 14rpx;
  opacity: 0.45;
}

.hour.on {
  opacity: 1;
}

.h-fam {
  font-size: 26rpx;
  font-weight: 600;
}

.h-range {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.h-bar {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  bottom: 0;
  height: 4rpx;
  border-radius: 2rpx;
  opacity: 0.3;
}

.hour.on .h-bar {
  height: 6rpx;
  opacity: 1;
}

.now {
  position: absolute;
  top: -10rpx;
  right: 12rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--danger);
}

/* 宜饮：同类茶左右滑动 */
.head {
  font-size: 28rpx;
  color: var(--muted);
}

.count {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 左右各露出一点相邻的罐子，提示可以滑动；swiper 撑满屏宽 */
.deck {
  height: 720rpx;
  margin: 0 -40rpx;
}

.slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  opacity: 0.4;
  transform: scale(0.82);
  transition: transform 0.3s, opacity 0.3s;
}

.slide.cur {
  opacity: 1;
  transform: scale(1);
}

/* 罐子身后一圈淡淡的茶色光晕 */
.slide-can {
  position: relative;
  width: 280rpx;
  margin-bottom: 40rpx;
}

.slide-can::before {
  content: '';
  position: absolute;
  left: -24%;
  right: -24%;
  top: -10%;
  bottom: -10%;
  border-radius: 50%;
  background: var(--c);
  opacity: 0.1;
}

.name {
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.name.dim {
  color: #b3ad9f;
}

.reason {
  margin-top: 12rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #5b574c;
}

.effect {
  margin-top: 10rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.also {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* 也宜：其他类的备选、缺的茶类、随手泡 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 44rpx 40rpx;
  margin-top: 24rpx;
}

.cell {
  width: calc((100% - 80rpx) / 3);
  text-align: center;
}

.cap {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cap.dim {
  color: #b3ad9f;
}

.sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 也宜模块下：近期喝过的记录 */
.recent {
  margin-top: 44rpx;
}

.recent-title {
  font-size: 26rpx;
  color: var(--muted);
}

.recent-count {
  font-size: 22rpx;
  color: var(--muted);
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.recent-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.recent-name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-cat {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.recent-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 20rpx;
}

.recent-stars {
  font-size: 22rpx;
  color: #d9a441;
  letter-spacing: 2rpx;
}

.recent-date {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.note {
  display: block;
  margin-top: 48rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--warn);
}

.source {
  display: block;
  margin-top: 40rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.6;
  color: #b3ad9f;
}
