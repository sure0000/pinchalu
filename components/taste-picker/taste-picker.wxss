.tp {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.tp-h {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.tp-group {
  margin-bottom: 12rpx;
}

.tp-row {
  display: flex;
  align-items: flex-start;
}

.tp-g {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.tp-tags {
  flex: 1;
  gap: 12rpx;
}
