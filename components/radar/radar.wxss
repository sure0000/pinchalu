:host {
  display: block;
}

.rd {
  position: relative;
  margin: 0 auto;
}

.rd-ring,
.rd-area {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.rd-ring {
  background: #e9e2d3;
}

.rd-ring.alt {
  background: #f4efe4;
}

.rd-spoke {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  height: 37%;
  margin-left: -1rpx;
  transform-origin: 50% 0;
  background: rgba(255, 253, 248, 0.9);
}

.rd-area {
  background: var(--c);
  opacity: 0.55;
}

.rd-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  background: var(--c);
}

.rd-label {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.2;
  color: #5d594f;
  white-space: nowrap;
}

.rd-v {
  color: var(--c);
  font-weight: 600;
}
