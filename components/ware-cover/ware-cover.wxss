:host {
  display: block;
}

/* 与茶叶罐等高，摆在同一种三列格子里 */
.wc {
  position: relative;
  width: 100%;
  padding-top: 128%;
}

/* 木格：内凹的阴影 + 底下一条搁板 */
.niche {
  position: absolute;
  left: 2%;
  right: 2%;
  top: 4%;
  bottom: 2%;
  border-radius: 14rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #e6dccb 0%, #efe7d8 70%);
  box-shadow: inset 0 8rpx 14rpx -6rpx rgba(80, 60, 40, 0.28);
}

.board {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 12%;
  background: linear-gradient(180deg, #c9b394 0%, #b79f7f 100%);
}

/* 背景层：同一张图铺满并模糊，消除 aspectFit 四周的底色 */
.img-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  -webkit-filter: blur(24rpx);
  filter: blur(24rpx);
  transform: scale(1.25);
  opacity: 0.9;
}

.img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cap {
  position: absolute;
  left: 10rpx;
  top: 8rpx;
  font-size: 18rpx;
  color: #9a8f7b;
}

/* 器物的各个部件：默认不显示，按器型摆放 */
.p,
.tea {
  position: absolute;
  display: none;
  background: var(--c);
}

.p::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.08) 0%, rgba(255, 255, 255, 0.3) 22%, rgba(255, 255, 255, 0) 50%, rgba(0, 0, 0, 0.16) 100%);
  pointer-events: none;
}

/* 把手、提梁：只有描边的圈 */
.p.ring {
  background: transparent;
}

/* 浅色材质（白瓷、汝窑、银）描一道边 */
.m-light .p {
  box-shadow: 0 0 0 2rpx rgba(90, 80, 60, 0.18);
}

/* 玻璃：透明、带边，能看到里面的茶汤 */
.m-glass .p {
  background: rgba(225, 238, 240, 0.5);
  box-shadow: 0 0 0 2rpx rgba(100, 130, 140, 0.45);
}

.m-glass .tea {
  display: block;
  background: rgba(205, 155, 60, 0.6);
}

/* ---- 盖碗：托、碗、盖、盖钮 ---- */
.k-gaiwan .p1 { display: block; left: 12%; right: 12%; bottom: 12%; height: 6%; border-radius: 50%; }
.k-gaiwan .p2 { display: block; left: 22%; right: 22%; bottom: 16.5%; height: 22%; border-radius: 6% 6% 50% 50% / 10% 10% 90% 90%; }
.k-gaiwan .p3 { display: block; left: 19%; right: 19%; bottom: 37.5%; height: 9%; border-radius: 50% 50% 12% 12% / 100% 100% 24% 24%; }
.k-gaiwan .p4 { display: block; left: 43%; right: 43%; bottom: 45.5%; height: 4.5%; border-radius: 30%; }

/* ---- 茶壶：壶身、壶盖、盖钮、壶嘴、把手 ---- */
.k-hu .p1 { display: block; left: 26%; right: 26%; bottom: 12%; height: 28%; border-radius: 46% 46% 40% 40% / 52% 52% 44% 44%; }
.k-hu .p2 { display: block; left: 37%; right: 37%; bottom: 38.5%; height: 4%; border-radius: 40%; }
.k-hu .p3 { display: block; left: 46%; right: 46%; bottom: 41.5%; height: 4%; border-radius: 50%; }
.k-hu .p4 { display: block; left: 11%; width: 20%; bottom: 29%; height: 5.5%; border-radius: 40% 20% 20% 40%; transform: rotate(-32deg); }
.k-hu .p5 { display: block; right: 11%; width: 17%; bottom: 18%; height: 18%; border-radius: 50%; border: 7rpx solid var(--c); box-sizing: border-box; background: transparent; }
.k-hu .p5::after { display: none; }

/* ---- 玻璃杯：高身直筒 + 茶汤 ---- */
.k-glass .p1 { display: block; left: 31%; right: 31%; bottom: 12%; height: 50%; border-radius: 4% 4% 14% 14% / 2% 2% 8% 8%; }
.k-glass .tea { left: 32.5%; right: 32.5%; bottom: 13%; height: 30%; border-radius: 0 0 12% 12% / 0 0 10% 10%; }

/* ---- 煮茶器：炉、壶身、提梁、壶嘴 ---- */
.k-boil .p1 { display: block; left: 27%; right: 27%; bottom: 12%; height: 13%; border-radius: 10% 10% 6% 6%; background: #6b5a4c; }
.k-boil .p2 { display: block; left: 23%; right: 23%; bottom: 25%; height: 21%; border-radius: 50% 50% 40% 40% / 62% 62% 38% 38%; }
.k-boil .p3 { display: block; left: 33%; right: 33%; bottom: 42%; height: 16%; border: 6rpx solid var(--c); border-bottom: none; box-sizing: border-box; border-radius: 50% 50% 0 0 / 100% 100% 0 0; background: transparent; }
.k-boil .p3::after { display: none; }
.k-boil .p4 { display: block; left: 12%; width: 16%; bottom: 37%; height: 5%; border-radius: 40% 20% 20% 40%; transform: rotate(-28deg); }

/* ---- 公道杯：杯身、出水嘴、把手 + 茶汤 ---- */
.k-gongdao .p1 { display: block; left: 28%; right: 30%; bottom: 12%; height: 33%; border-radius: 6% 6% 16% 16% / 4% 4% 12% 12%; }
.k-gongdao .p2 { display: block; left: 21%; width: 14%; bottom: 41.5%; height: 4.5%; border-radius: 50% 10% 10% 50%; transform: rotate(-22deg); }
.k-gongdao .p3 { display: block; right: 17%; width: 15%; bottom: 20%; height: 18%; border-radius: 40%; border: 6rpx solid var(--c); box-sizing: border-box; background: transparent; }
.k-gongdao .p3::after { display: none; }
.k-gongdao .tea { left: 29.5%; right: 31.5%; bottom: 13%; height: 18%; border-radius: 0 0 14% 14% / 0 0 12% 12%; }

/* ---- 品茗杯：一大一小两只 ---- */
.k-cup .p1 { display: block; left: 18%; width: 40%; bottom: 16%; height: 19%; border-radius: 4% 4% 50% 50% / 8% 8% 92% 92%; }
.k-cup .p2 { display: block; left: 31%; width: 14%; bottom: 12%; height: 4.5%; border-radius: 3rpx; }
.k-cup .p3 { display: block; left: 60%; width: 26%; bottom: 15%; height: 12%; border-radius: 4% 4% 50% 50% / 8% 8% 92% 92%; }
.k-cup .p4 { display: block; left: 68.5%; width: 9%; bottom: 12%; height: 3.5%; border-radius: 3rpx; }

/* ---- 烧水壶：高身、提梁、壶嘴 ---- */
.k-kettle .p1 { display: block; left: 29%; right: 29%; bottom: 12%; height: 34%; border-radius: 34% 34% 12% 12% / 26% 26% 8% 8%; }
.k-kettle .p2 { display: block; left: 34%; right: 34%; bottom: 43%; height: 14%; border: 6rpx solid var(--c); border-bottom: none; box-sizing: border-box; border-radius: 50% 50% 0 0 / 100% 100% 0 0; background: transparent; }
.k-kettle .p2::after { display: none; }
.k-kettle .p3 { display: block; left: 14%; width: 20%; bottom: 34%; height: 5%; border-radius: 40% 20% 20% 40%; transform: rotate(-38deg); }

/* ---- 其他：茶盘 + 茶则 ---- */
.k-other .p1 { display: block; left: 8%; right: 8%; bottom: 12%; height: 8%; border-radius: 10rpx; }
.k-other .p2 { display: block; left: 14%; right: 14%; bottom: 17%; height: 1.2%; background: rgba(0, 0, 0, 0.16); }
.k-other .p3 { display: block; left: 30%; right: 26%; bottom: 21%; height: 5%; border-radius: 50% 50% 18% 18%; transform: rotate(-6deg); }

.badge {
  position: absolute;
  z-index: 3;
  top: 4%;
  right: 2%;
  padding: 0 10rpx;
  border-radius: 0 14rpx 0 12rpx;
  background: #a9a397;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
}

/* 收起不用 */
.gray .niche {
  filter: grayscale(1);
  opacity: 0.55;
}

/* 末尾的“＋”格 */
.k-add .niche {
  background: transparent;
  box-shadow: none;
  border: 2rpx dashed #cfc8b9;
  box-sizing: border-box;
}

.plus {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  font-size: 56rpx;
  font-weight: 200;
  color: #b3ad9f;
}
