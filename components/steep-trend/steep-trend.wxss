.st {
  margin-top: 8rpx;
}

.st-h {
  font-size: 26rpx;
  color: var(--muted);
  margin: 16rpx 0 12rpx;
}

.st-hint {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #b3ad9f;
}

.st-tl {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.st-step {
  display: flex;
  align-items: flex-start;
}

.st-sn {
  flex-shrink: 0;
  width: 96rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.st-chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.st-chip {
  padding: 0 18rpx;
  height: 48rpx;
  line-height: 46rpx;
  border-radius: 24rpx;
  border: 1rpx solid;
  font-size: 24rpx;
  white-space: nowrap;
}

.st-none {
  color: #b3ad9f;
  font-size: 24rpx;
  line-height: 48rpx;
}

.st-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  margin-bottom: 12rpx;
}

.st-lg {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6a675f;
}

.st-lg-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.st-canvas {
  width: 100%;
  height: 420rpx;
  box-sizing: border-box;
}

.st-empty {
  margin-top: 8rpx;
  color: #b3ad9f;
  font-size: 26rpx;
}
